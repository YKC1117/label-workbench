+    Assert-NativeFinite ([double]$r.inkWidthMm) 'inkWidthMm';Assert-NativeFinite ([double]$r.inkHeightMm) 'inkHeightMm'
+    if($r.inkWidthPx -le 0 -or $r.inkHeightPx -le 0){throw 'Raster has no ink.'}
